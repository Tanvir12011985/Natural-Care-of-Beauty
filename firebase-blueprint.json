{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "buyingPrice": { "type": "number" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "stock": { "type": "number", "description": "Current stock quantity" }
      },
      "required": ["name", "price", "category", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order and delivery slip info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerMobile": { "type": "string" },
        "customerAddress": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Pending", "Packing done", "Hand over to the currier agent", "delivery done"]
        },
        "timestamp": { "type": "string" },
        "deliveryCharge": { "type": "number" },
        "totalAmount": { "type": "number" },
        "dateFields": {
          "type": "object",
          "properties": {
            "day": { "type": "string" },
            "month": { "type": "string" },
            "year": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "description": "List of products in the order"
        }
      },
      "required": ["orderNumber", "invoiceNumber", "customerName", "status", "totalAmount"]
    },
    "Member": {
      "title": "Member",
      "description": "Verified member record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message in a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "timestamp": { "type": "string" },
        "sessionId": { "type": "string" }
      },
      "required": ["text", "senderId", "isAdmin", "timestamp", "sessionId"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders and slips"
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Member database"
    },
    "/chats/{sessionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages for a specific session"
    }
  }
}
