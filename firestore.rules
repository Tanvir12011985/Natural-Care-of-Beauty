rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // For this app, we trust the owner email or an entry in admins collection
      return isEmailVerified() && (
        request.auth.token.email == 'tanvir.khc@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // Products
    match /products/{productId} {
      function isValidProduct(p) {
        return p.name is string && p.name.size() > 0 && p.name.size() <= 200 &&
               p.price is number && p.price >= 0 &&
               p.buyingPrice is number && p.buyingPrice >= 0 &&
               p.category is string &&
               p.imageUrl is string && p.imageUrl.size() <= 1048576 &&
               p.stock is number && p.stock >= 0 &&
               (!p.keys().hasAny(['description']) || (p.description is string && p.description.size() <= 10000)) &&
               (!p.keys().hasAny(['id']) || p.id == productId) &&
               (!p.keys().hasAny(['discountPercentage']) || (p.discountPercentage is number && p.discountPercentage >= 0 && p.discountPercentage <= 100)) &&
               (!p.keys().hasAny(['isOffer']) || p.isOffer is bool);
      }

      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if (isAdmin() && isValidProduct(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'price', 'buyingPrice', 'description', 'imageUrl', 'category', 'stock', 'id', 'discountPercentage', 'isOffer'])
      )) || (
        // Public can reduce stock during purchase
        incoming().diff(existing()).affectedKeys().hasOnly(['stock']) &&
        incoming().stock < existing().stock &&
        incoming().stock >= 0
      );
      allow delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      function isValidOrder(o) {
        return o.orderNumber is string && o.orderNumber.size() > 0 &&
               o.invoiceNumber is string && o.invoiceNumber.size() > 0 &&
               o.customerName is string && o.customerName.size() > 0 &&
               o.status in ['Pending', 'Packing done', 'Hand over to the currier agent', 'delivery done'] &&
               o.totalAmount is number && o.totalAmount >= 0;
      }

      allow create: if isValidOrder(incoming()) && isValidId(orderId);
      allow get: if true; // Public can view a specific slip by ID
      allow list: if isAdmin(); // Only admins can browse all orders
      allow update: if isAdmin() && isValidOrder(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    // Members
    match /members/{memberId} {
      allow read, write: if isAdmin();
    }

    // Chats
    match /chats/{sessionId} {
      function isValidSession(s) {
        return s.customerName is string && s.customerName.size() > 0 &&
               s.lastMessage is string &&
               s.lastMessageAt is string &&
               s.visitorId is string;
      }

      allow read: if isAdmin() || sessionId == request.auth.uid || sessionId.startsWith('visitor-');
      allow create, update: if (isAdmin() || sessionId == request.auth.uid || sessionId.startsWith('visitor-')) && isValidSession(incoming());
      
      match /messages/{messageId} {
        function isValidMessage(m) {
          return m.text is string && m.text.size() > 0 && m.text.size() <= 2000 &&
                 m.senderId is string &&
                 m.senderName is string &&
                 m.isAdmin is bool &&
                 m.timestamp is string;
        }

        allow read: if isAdmin() || sessionId == request.auth.uid || sessionId.startsWith('visitor-');
        allow create: if (isAdmin() || sessionId == request.auth.uid || sessionId.startsWith('visitor-')) && isValidMessage(incoming());
      }
    }
    
    // Admins bootstrap
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or service account
    }

    // Advertisements
    match /advertisements/{adId} {
      function isValidAd(a) {
        return a.title is string && a.title.size() > 0 && a.title.size() <= 200 &&
               a.imageUrl is string && a.imageUrl.size() <= 1048576 &&
               a.active is bool &&
               a.order is number &&
               (!a.keys().hasAny(['description']) || (a.description is string && a.description.size() <= 1000)) &&
               (!a.keys().hasAny(['linkUrl']) || (a.linkUrl is string && a.linkUrl.size() <= 1000));
      }
      allow read: if true;
      allow create: if isAdmin() && isValidAd(incoming()) && isValidId(adId);
      allow update: if isAdmin() && isValidAd(incoming());
      allow delete: if isAdmin();
    }
  }
}
